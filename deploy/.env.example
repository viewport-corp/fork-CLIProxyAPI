# Viewport internal deploy overlay for CLIProxyAPI — env template
# Copy to .env and fill in. NO real secrets in this file.

# REQUIRED — management API password (do not hardcode; injected via env)
MANAGEMENT_PASSWORD=change-me

# OPTIONAL — deploy marker passed through to the container
DEPLOY=

# OPTIONAL — storage / volume source paths (defaults shown in compose)
# Override only if your host paths differ from the compose defaults.
CLI_PROXY_CONFIG_PATH=./config.yaml
CLI_PROXY_AUTH_PATH=./auths
CLI_PROXY_LOG_PATH=./logs
